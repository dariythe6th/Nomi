<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Гео -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Кружочки (камера/микрофон) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Сеть, уведомления -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:theme="@style/Theme.BlinkZenly"
        android:usesCleartextTraffic="false">

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="ВАШ_GOOGLE_MAPS_API_KEY" />

        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".auth.LoginActivity" android:exported="false" />
        <activity android:name=".auth.RegisterActivity" android:exported="false" />

        <activity android:name=".map.MapActivity" android:exported="false" />
        <activity android:name=".status.StatusActivity" android:exported="false" />
        <activity android:name=".marks.AddMarkActivity" android:exported="false" />

        <activity android:name=".chat.ChatListActivity" android:exported="false" />
        <activity android:name=".chat.ChatActivity" android:exported="false" />
        <activity android:name=".chat.CircleRecordActivity" android:exported="false" />

        <activity android:name=".route.RouteActivity" android:exported="false" />

        <service
            android:name=".map.LocationService"
            android:foregroundServiceType="location"
            android:exported="false" />

        <service
            android:name=".notifications.MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>
</manifest>
